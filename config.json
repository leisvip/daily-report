  "reminder": {
    "mode": "count",
    "count_threshold": 3,
    "remind_interval": 0,
    "quiet_hours": {
      "enabled": true,
      "start": "23:00",
      "end": "08:00"
    }
  },
  "report_scope": {
    "mode": "all",
    "week_start": "monday",
    "month_report_day": 1
